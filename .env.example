# Copy to .env.local and fill in. Never commit real values.

# PlanetScale Postgres. Same credentials, two ports.
# App and scripts/seed.ts: PgBouncer (transaction pooling) on 6432.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6432/postgres?sslmode=verify-full
# pnpm db:migrate and other DDL: direct connection on 5432.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# 32 random bytes, encoded as 64 hex characters. Keep stable to decrypt saved data.
EVE_VAULT_KEY=
# Enables fictional personas and the resettable sample organization.
EVE_DEMO_MODE=true
# Authenticates the scheduled sweep and the private read-only integration probe.
CRON_SECRET=

# Claude via the AI SDK
ANTHROPIC_API_KEY=
EVE_AGENT_MODEL=claude-sonnet-5-5

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Duffel (test mode)
DUFFEL_ACCESS_TOKEN=

# SerpApi Google Flights price insights for the fare check (optional; free tier ~250 searches/month).
# Unset: simulated typical fares.
SERPAPI_API_KEY=

# Eve Slack app (docs/slack.md). Create it from slack/manifest.yml. Unset: Slack is off.
# An organizer connects a workspace in Settings; nothing posts until then.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Public base URL for "Open in Eve" links and the OAuth redirect. Defaults to BETTER_AUTH_URL.
EVE_APP_URL=

# Notifications
# Off by default. Sample organizations always simulate external delivery.
EVE_NOTIFICATIONS_LIVE=false
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=
EVE_EMAIL_FROM=
