# Copy to .env.local and fill in. Never commit real values.

# PlanetScale Postgres. Same credentials, two ports.
# App and scripts/seed.ts: PgBouncer (transaction pooling) on 6432.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6432/postgres?sslmode=verify-full
# drizzle-kit migrations and other DDL: direct connection on 5432.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Claude via the AI SDK
ANTHROPIC_API_KEY=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Duffel (test mode)
DUFFEL_ACCESS_TOKEN=

# Notifications
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=
